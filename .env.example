# Database
DATABASE_URL=postgresql+asyncpg://jobmatch:dev@localhost:5432/jobmatch
REDIS_URL=redis://localhost:6379/0

# LLM providers (LiteLLM picks these up)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RESUMES=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_PUBLIC_KEY=

# Observability
SENTRY_DSN=
LOGFIRE_TOKEN=

# App
APP_ENV=dev               # dev | staging | prod
APP_LOG_LEVEL=INFO
PIPELINE_COST_CAP_USD=1.50
PIPELINE_TIME_CAP_S=45
TENANT_MONTHLY_COST_CAP_USD=50

# Encryption
DB_ENCRYPTION_KEY=         # 32-byte base64
